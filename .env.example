# Django Production Environment Configuration

# Set to False for production
DEBUG=False

# Django Secret Key (generate a strong secret key for production)
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database Connection (Supabase / Neon / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Allowed Hosts (comma-separated domains or * for all)
ALLOWED_HOSTS=*

# CORS Settings (allow frontend domains to connect)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# CSRF Trusted Origins (comma-separated domains including protocol)
CSRF_TRUSTED_ORIGINS=https://your-backend-domain.onrender.com,https://your-frontend.vercel.app

# Celery & Redis Task Queue
REDIS_URL=redis://localhost:6379/0
USE_LOCAL_REDIS=False

# External Railway Telemetry (RailKit)
RAILKIT_API_KEY=your_railkit_api_key_here
RAILKIT_BASE_URL=https://railkit.in
ENABLE_LIVE_SYNC=False

# Global Development Security Key (enforced in request headers as X-DEV-KEY when DEBUG=True)
DEV_KEY=your-secure-dev-key-here
# DEV_KEY_REQUIRED=False

# API Rate Limiting & Anti-Spam (DRF Throttling)
ENABLE_THROTTLING=True
THROTTLE_RATE_ANON=xx/minute
THROTTLE_RATE_USER=xx/minute
THROTTLE_RATE_AI=xx/minute
# DEV_KEY_BYPASS_THROTTLE=False
