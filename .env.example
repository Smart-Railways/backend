# Django Production Environment Configuration

# Set to False for production
DEBUG=False

# Django Secret Key (generate a strong secret key for production)
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database Connection (Supabase / Neon / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Allowed Hosts (comma-separated domains or * for all)
ALLOWED_HOSTS=*

# CORS Settings (allow frontend domains to connect)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# CSRF Trusted Origins (comma-separated domains including protocol)
CSRF_TRUSTED_ORIGINS=https://your-backend-domain.onrender.com,https://your-frontend.vercel.app
