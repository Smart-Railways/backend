# ==============================================================================
# Railway-AI Django Backend Environment Configuration
# ==============================================================================

# General
DJANGO_DEBUG=False
SECRET_KEY=replace-with-a-secure-random-50-character-secret-key

# Networking & Security
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Database Connection (PostgreSQL)
# Local: postgresql://postgres:postgres@localhost:5432/railway_db
# Docker: postgresql://railway_admin:railway_secure_pass@postgres:5432/railway_prod
# Managed PaaS: postgresql://user:pass@host.region.provider.com:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Celery & Redis Task Queue
# Local: redis://localhost:6379/0
# Docker: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
USE_LOCAL_REDIS=False

# Railway AI Microservice Connection
# Local: http://localhost:8001
# Docker internal network: http://ai-engine:8001
# PaaS private service: http://ai-service.railway.internal:8001
AI_SERVICE_URL=http://localhost:8001
AI_TIMEOUT_SECONDS=15

# External Railway Telemetry
RAILKIT_API_KEY=your_railkit_api_key_here
RAILKIT_BASE_URL=https://railkit.in
ENABLE_LIVE_SYNC=False
