meta {
  name: Get Maintenance Batch by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/railways/maintenance-batches/1/
  body: none
  auth: none
}

assert {
  res.status: in [200, 404]
}

docs {
  # Get Combined Maintenance Batch

  Replace `1` with the `batch_id` returned by **Create Combined Maintenance
  Batch**. The response provides the shared block window and every linked
  task/asset for the frontend batch-detail page.
}
