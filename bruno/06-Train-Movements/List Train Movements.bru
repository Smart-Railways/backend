meta {
  name: List Train Movements
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/railways/train-movements/?from=NDLS&to=MTJ&page=1&page_size=20
  body: none
  auth: none
}

params:query {
  from: NDLS
  to: MTJ
  page: 1
  page_size: 20
}

vars:pre-request {
  baseUrl: https://backend-oz3h.onrender.com
}

assert {
  res.status: eq 200
  res.body: isDefined
}

docs {
  # Live movement fields

  A movement may contain observed `actual_entry_time` and
  `actual_exit_time`, or live estimates supplied by the local railway
  service:

  - `estimated_entry_time` and `estimated_exit_time` are timetable times plus
    the reported delay.
  - `delay_minutes`, `status_label`, and `last_live_update` describe the
    latest live-status refresh.
  - Estimated values never overwrite the `actual_*` fields.
  - Results are paginated; use `page` and `page_size` (maximum 100).
  - Filter one section by station codes with `from=NDLS&to=MTJ`.

  Run `uv run python manage.py sync_railway_data` before this request to
  refresh selected live movements.
}
