meta {
  name: List Train Schedules
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/railways/train-schedules/
  body: none
  auth: none
}

params:query {
  ~date: 2026-09-04
  ~source: NDLS
  ~destination: CNB
  ~page: 1
  ~page_size: 20
}

vars:pre-request {
  baseUrl: http://localhost:8000
}

assert {
  res.status: eq 200
  res.body: isDefined
}
