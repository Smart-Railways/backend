meta {
  name: List Train Schedules
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/railways/train-schedules/?source=NDLS&destination=MTJ&page=1&page_size=20
  body: none
  auth: none
}

params:query {
  source: NDLS
  destination: MTJ
  page: 1
  page_size: 20
  ~date: 2026-09-04
}

vars:pre-request {
  baseUrl: https://backend-oz3h.onrender.com
}

assert {
  res.status: eq 200
  res.body: isDefined
}

docs {
  # Scheduled timetable

  `scheduled_exit_day_offset` is `1` when a section exits on the day after
  its scheduled entry; otherwise it is `0`. Refresh section schedules with:

  `uv run python manage.py sync_section_trains`
}
