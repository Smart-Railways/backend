meta {
  name: List Train Schedules
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/railways/train-schedules/?source=NDLS&destination=MTJ&page=1&page_size=20
  body: none
  auth: none
}

params:query {
  source: NDLS
  destination: MTJ
  page: 1
  page_size: 20
  ~date: 2026-09-04
}

vars:pre-request {
  baseUrl: https://backend-oz3h.onrender.com
}

assert {
  res.status: eq 200
  res.body: isDefined
}
