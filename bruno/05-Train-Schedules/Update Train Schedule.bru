meta {
  name: Update Train Schedule
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/railways/train-schedules/1/
  body: json
  auth: none
}

body:json {
  {
    "train": 1,
    "section": 1,
    "scheduled_entry_time": "06:15:00",
    "scheduled_exit_time": "06:55:00",
    "running_days": "1111111",
    "is_active": true
  }
}

assert {
  res.status: in [200, 404]
}
