meta {
  name: Get Train Operations
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/railways/trains/operations/?date=2026-09-04&source=NDLS&destination=GZB
  body: none
  auth: none
}

params:query {
  date: 2026-09-04
  source: NDLS
  destination: GZB
}

vars:pre-request {
  baseUrl: https://backend-oz3h.onrender.com
}

assert {
  res.status: in [200, 400, 404]
}

docs {
  # Train operations

  Use a date and the source/destination station codes for an active section.
  The response includes scheduled times and, when available, actual or
  estimated movement times. Live estimates are refreshed with:

  `uv run python manage.py sync_railway_data --date YYYY-MM-DD`
}
