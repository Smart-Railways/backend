meta {
  name: Update Block Window by Task ID
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/railways/block-windows/by-task/TMS-363/
  body: json
  auth: none
}

body:json {
  {
    "start_time": "2026-09-08 00:30:00",
    "end_time": "2026-09-08 04:30:00",
    "status": "RESERVED"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8000
}

assert {
  res.status: in [200, 201, 404]
}

docs {
  # Update Block Window by Task ID
  
  Update (PUT/PATCH) the block window directly using the maintenance task_id (e.g. `TMS-190`).
  If a block window does not exist yet for this task, PUT creates one.
}
