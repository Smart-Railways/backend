meta {
  name: AI Recommendation - Auto Apply Slot
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/railways/block-windows/recommendation/
  body: json
  auth: none
}

body:json {
  {
    "block_window_id": 1,
    "task_id": "TMS-696",
    "apply": true
  }
}

vars:pre-request {
  baseUrl: http://127.0.0.1:8000
}

assert {
  res.status: in [200, 400, 404]
}
